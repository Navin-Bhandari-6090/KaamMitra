                    "type": "number",
                    "format": "double"
                  },
                  "Longitude": {
                    "type": "number",
                    "format": "double"
                  },
                  "Photo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Role": {
                    "maxLength": 50,
                    "minLength": 0,
                    "type": "string"
                  }
                }
              },
