                  "WhatsappPhoneNumber"
                ],
                "type": "object",
                "properties": {
                  "UserNumber": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "FirstName": {
                    "maxLength": 50,
                    "minLength": 0,
                    "type": "string"
                  },
                  "LastName": {
                    "maxLength": 50,
                    "minLength": 0,
                    "type": "string"
                  },
                  "Email": {
                    "maxLength": 200,
                    "minLength": 0,
                    "type": "string",
                    "format": "email"
                  },
                  "PhoneNumber": {
                    "maxLength": 50,
                    "minLength": 0,
                    "pattern": "^\\+\\d+$",
                    "type": "string"
                  },
                  "WhatsappPhoneNumber": {
                    "maxLength": 50,
                    "minLength": 0,
                    "pattern": "^\\+\\d+$",
                    "type": "string"
                  },
                  "Password": {
                    "type": "string"
                  },
